{
  "name": "dark",
  "version": "1.1.0",
  "description": "Dark theme. No external dependencies.",
  "author": "OpenDigitalCC",
  "layouts": ["default"],
  "config": {
    "colours": {
      "primary": "#6db3f2",
      "primary-hover": "#8ac7ff",
      "primary-text": "#11212f",
      "text": "#e0e0e0",
      "text-muted": "#aaaaaa",
      "text-dim": "#777777",
      "heading": "#f0f0f0",
      "background": "#1a1a1a",
      "background-alt": "#2a2a2a",
      "background-accent": "#1e2d3d",
      "background-dropdown": "#232323",
      "border": "#333333",
      "success": "#5ad17a",
      "error": "#ff6b6b",
      "mark": "#4a3f00",
      "mark-text": "#ffe9a8",
      "shadow": "rgba(0, 0, 0, 0.6)"
    },
    "fonts": {
      "body": "system-ui, -apple-system, sans-serif",
      "heading": "system-ui, -apple-system, sans-serif",
      "code": "ui-monospace, Menlo, Consolas, monospace"
    },
    "spacing": {
      "measure": "800px",
      "radius": "6px"
    }
  },
  "files": [
    "theme.json",
    "assets/main.css"
  ]
}
