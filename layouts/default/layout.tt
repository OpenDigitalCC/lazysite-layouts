<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  [%# The <head> contract. page_meta_title / page_meta_desc arrive from the
      engine already resolved (meta_title // title, meta_desc // subtitle) and
      HTML-escaped, so they are emitted WITHOUT | html - filtering again turns
      an apostrophe into &amp;#39; in the served tag. Do not repeat the fallback
      here: the registries (sitemap.xml, llms.txt, the feeds) use the same
      resolved values, and a layout that duplicates the resolution drifts.
      og:site_name carries the site name, so og:title is JUST the page title - no
      redundant " - site" (that suffix belongs only in the <title> tag). %]
  [% IF page_meta_desc %]<meta name="description" content="[% page_meta_desc %]">[% END %]
  <meta property="og:title" content="[% page_meta_title %]">
  [% IF page_meta_desc %]<meta property="og:description" content="[% page_meta_desc %]">[% END %]
  <meta property="og:type" content="website">
  [% IF site_name %]<meta property="og:site_name" content="[% site_name | html %]">[% END %]
  [% IF site_url %]<meta property="og:url" content="[% site_url | html %][% request_uri | html %]">[% END %]
  [% IF site_url %]<link rel="canonical" href="[% site_url | html %][% request_uri | html %]">[% END %]
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="[% page_meta_title %]">
  [% IF page_meta_desc %]<meta name="twitter:description" content="[% page_meta_desc %]">[% END %]
  <title>[% page_meta_title %][% IF site_name %] - [% site_name %][% END %]</title>
  [%# D013: theme_css emits <style>:root { --theme-*-*: ...; } %]
  <link rel="icon" href="[% theme_assets %]/favicon.svg" type="image/svg+xml">
  [% theme_css %]
  [% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/main.css">[% END %]
  <style>
  .nav-toggle { display: none; background: none; border: 1px solid currentColor; border-radius: 6px; font-size: 1.2rem; line-height: 1; cursor: pointer; color: inherit; padding: 3px 11px; }
  @media (max-width: 720px) {
    .nav-toggle { display: block; }
    .site-header .site-nav { display: none; width: 100%; order: 4; }
    body.nav-open .site-header .site-nav { display: block; }
    .site-header .site-nav ul { flex-direction: column; gap: 2px; }
  }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="wrapper">
      <h1 class="site-name"><a href="/">[% site_name %]</a></h1>
      <div class="site-tools">
        [%# Cache-safe sign in/out: pages are cached and shared, so a server-side
            IF-authenticated check would bake the wrong state into the cached HTML.
            Both links ship hidden; the injected auth-sync script reveals the right
            one from the lzs_session cookie, client-side. %]
        <span class="auth-indicator" data-ls-auth-out style="display:none">
          <a href="/cgi-bin/lazysite-auth.pl?action=logout" class="auth-link auth-logout">Sign out</a>
        </span>
        <a href="/login" data-ls-auth-in class="auth-link auth-signin" style="display:none">Sign in</a>
      </div>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">&#9776;</button>
      <nav class="site-nav" id="site-nav">
        <ul>
        [% FOREACH item IN nav %]
          [% IF item.children.size %]
          <li class="nav-group">
            [% IF item.url %]
            <a href="[% item.url %]"
              [% IF request_uri == item.url %]class="active"[% END %]>[% item.label %]</a>
            [% ELSE %]
            <span class="nav-group-label">[% item.label %]</span>
            [% END %]
            <ul class="nav-children">
            [% FOREACH child IN item.children %]
              <li><a href="[% child.url %]"
                [% IF request_uri == child.url %]class="active"[% END %]>[% child.label %]</a></li>
            [% END %]
            </ul>
          </li>
          [% ELSE %]
          <li><a href="[% item.url %]"
            [% IF request_uri == item.url %]class="active"[% END %]>[% item.label %]</a></li>
          [% END %]
        [% END %]
        </ul>
      </nav>
    </div>
  </header>

  <main class="site-content">
    <div class="wrapper">
      <article>
        <header class="page-header">
          <h1 class="page-title">[% page_title %]</h1>
          [% IF page_subtitle %]
          <p class="page-subtitle">[% page_subtitle %]</p>
          [% END %]
        </header>
        <div class="page-body">
          [% FOREACH s IN sections %][% type = s.keys.first %][% INCLUDE "components/${type}.tt" data = s.$type %]
          [% END %][% content %]
        </div>
        [% IF page_modified %]
        <time datetime="[% page_modified_iso %]" class="page-modified">Last updated: [% page_modified %]</time>
        [% END %]
      </article>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrapper">
      <span>&copy; [% site_name %]</span>
      <span><a href="https://lazysite.io">This is a Lazysite</a></span>
    </div>
  </footer>

  <script>
  (function(){var b=document.querySelector('.nav-toggle');if(!b)return;b.addEventListener('click',function(){var o=document.body.classList.toggle('nav-open');b.setAttribute('aria-expanded',o?'true':'false');});})();
  </script>
</body>
</html>
