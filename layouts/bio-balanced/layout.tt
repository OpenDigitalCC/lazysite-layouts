<!DOCTYPE html>
<html lang="[% page_lang || site_lang || 'en' %]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
[%# The <head> contract: page_meta_title / page_meta_desc arrive from the engine
    already resolved (meta_title // title, meta_desc // subtitle) and
    HTML-escaped - emit them WITHOUT | html, and never repeat the fallback here.
    og:site_name carries the site name, so og:title is the page title alone. %]
<title>[% page_meta_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_meta_desc %]<meta name="description" content="[% page_meta_desc %]">[% END %]
<meta property="og:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta property="og:description" content="[% page_meta_desc %]">[% END %]
<meta property="og:type" content="website">
[% IF site_name %]<meta property="og:site_name" content="[% site_name | html %]">[% END %]
[% IF site_url %]<meta property="og:url" content="[% site_url | html %][% request_uri | html %]">
<link rel="canonical" href="[% site_url | html %][% request_uri | html %]">[% END %]
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta name="twitter:description" content="[% page_meta_desc %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/bio-balanced/bio-balanced/fonts.css"><link rel="stylesheet" href="/lazysite-assets/bio-balanced/bio-balanced/main.css">[% END %]
</head>
<body>
<nav class="bio-nav"><div class="in">
<a class="me" href="/">[% site_name %]</a>
<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="bio-links">&#9776;</button>
<ul class="menu" id="bio-links">
[% FOREACH item IN nav %]
[% IF item.children.size %]
<li class="nav-group">
[% IF item.url %]<a href="[% item.url %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a>[% ELSE %]<span class="nav-group-label">[% item.label %]</span>[% END %]
<ul class="nav-children">
[% FOREACH child IN item.children %]<li><a href="[% child.url %]"[% IF request_uri == child.url %] class="active"[% END %]>[% child.label %]</a></li>[% END %]
</ul>
</li>
[% ELSE %]
<li><a href="[% item.url %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a></li>
[% END %]
[% END %]
<li class="auth">[% auth_control %]</li>
</ul>
</div></nav>
[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% IF content %]<div class="bio-page"><div class="wrap">
[% IF page_title %]<h1 class="page-title">[% page_title %]</h1>[% END %]
[% IF page_subtitle %]<p class="standfirst">[% page_subtitle %]</p>[% END %]
[% content %]
</div></div>[% END %]
<footer class="bio-foot"><span>&copy; [% year %] [% site_name %]</span> &middot; <a href="https://lazysite.io">This is a Lazysite</a>[% IF page_modified %] &middot; <time datetime="[% page_modified_iso %]">Last updated: [% page_modified %]</time>[% END %]</footer>
<script>
(function(){var b=document.querySelector('.nav-toggle');if(!b)return;b.addEventListener('click',function(){var o=document.body.classList.toggle('nav-open');b.setAttribute('aria-expanded',o?'true':'false');});})();
</script>
</body>
</html>
