<section class="cards"><div class="card"><h3>[% data.chart.title %]</h3><p class="sub">[% data.chart.sub %]</p><svg class="barchart" viewBox="0 0 360 200" preserveAspectRatio="none"><line class="axis" x1="8" y1="176" x2="352" y2="176"/>[% FOREACH b IN data.bars %]<rect class="bar[% IF b.alt %] alt[% END %]" x="[% b.x %]" y="[% b.y %]" width="24" height="[% b.h %]" rx="4"/><text x="[% b.tx %]" y="192" text-anchor="middle">[% b.label %]</text>[% END %]</svg></div><div class="card"><h3>[% data.donut.title %]</h3><p class="sub">[% data.donut.sub %]</p><div class="donut-wrap"><svg class="donut" viewBox="0 0 120 120"><circle class="track" cx="60" cy="60" r="46"/>[% FOREACH g IN data.segments %]<circle class="[% g.cls %]" cx="60" cy="60" r="46" stroke-dasharray="[% g.dash %]" stroke-dashoffset="[% g.offset %]"/>[% END %]</svg><div class="legend">[% FOREACH li IN data.legend %]<div class="li"><span class="sw" style="[% li.style %]"></span>[% li.label %]<span class="v">[% li.value %]</span></div>[% END %]</div></div></div></section>