<section class="cards2"><div class="card controls"><h3>[% data.controls.title %]</h3><p class="sub">[% data.controls.sub %]</p>[% FOREACH r IN data.rows %]<div class="row"><div><div class="rl">[% r.rl %]</div><div class="rs">[% r.rs %]</div></div>[% IF r.slider %]<div class="slider"><div class="fill" style="width:[% r.slider %]%"></div><div class="thumb" style="left:[% r.slider %]%"></div></div>[% ELSE %]<div class="switch[% IF r.active %] on[% END %]"></div>[% END %]</div>[% END %]</div><div class="card"><h3>[% data.services.title %]</h3><p class="sub">[% data.services.sub %]</p><table class="table"><thead><tr><th>Service</th><th>Region</th><th>Latency</th><th>Status</th></tr></thead><tbody>[% FOREACH t IN data.table %]<tr><td>[% t.service %]</td><td>[% t.region %]</td><td class="mono">[% t.latency %]</td><td><span class="badge [% t.badge %]">[% t.status %]</span></td></tr>[% END %]</tbody></table></div></section>