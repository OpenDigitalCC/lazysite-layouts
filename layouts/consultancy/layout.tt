<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/consultancy/consultancy/fonts.css"><link rel="stylesheet" href="/lazysite-assets/consultancy/consultancy/main.css">[% END %]
</head>
<body>
<nav class="ps-nav"><div class="in">
<a class="logo" href="#top">Meridian &amp; Co</a>
<ul class="links"><li><a href="#services">Services</a></li><li><a href="#approach">Approach</a></li><li><a href="/" class="ex">&larr; Explorer</a></li><li><a href="#contact" class="cta">Book a briefing</a></li></ul>
</div></nav>
[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]
<footer class="ps-foot"><div class="in">
<div><div class="logo">Meridian &amp; Co</div><p>A management consultancy for ambitious leadership teams - strategy, operating model and transformation.</p></div>
<div><h4>Practice</h4><ul><li><a href="#services">Services</a></li><li><a href="#approach">Approach</a></li><li><a href="#contact">Contact</a></li></ul></div>
<div><h4>lazysite</h4><ul><li><a href="/">Theme explorer</a></li><li><a href="https://lazysite.io">This is a Lazysite</a></li></ul></div>
</div><div class="base"><span>&copy; [% year %] Meridian &amp; Co - a lazysite professional-services theme.</span><span>Demo content</span></div></footer>
</body>
</html>
