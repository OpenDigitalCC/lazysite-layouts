<section class="services" id="services"><div class="wrap">[% IF data.eyebrow %]<span class="eyebrow">[% data.eyebrow %]</span>[% END %]<h2 class="h2">[% data.heading %]</h2>[% IF data.lead %]<p class="lead">[% data.lead %]</p>[% END %]<div class="svc-grid">[% FOREACH s IN data.items %]<div class="svc"><div class="n">[% s.n %]</div><h3>[% s.title %]</h3><p>[% s.body %]</p></div>[% END %]</div></div></section>
