<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">[% theme_css %][% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/folio/folio/main.css">[% END %]</head><body><header class="folio-head"><div class="pub">The Folio</div><div class="tag">Essays on craft, attention and the long view</div><nav class="nav"><a href="#lead">Latest</a><a href="#essays">Essays</a><a href="#about">About</a><a href="/">Explorer</a></nav></header>[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]<footer class="folio-foot">The Source - a lazysite reading theme. <a href="/">Back to the theme explorer</a> &middot; [% year %]</footer></body></html>
