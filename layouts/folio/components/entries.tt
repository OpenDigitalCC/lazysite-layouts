<section class="essays" id="essays"><div class="wrap"><span class="label">[% data.label %]</span>[% FOREACH item IN data.items %]<article class="post"><div class="when">[% item.when %]</div><div><h2><a href="[% item.href %]">[% item.title %]</a></h2><p class="dek">[% item.dek %]</p></div></article>[% END %]</div></section>