<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %][% theme_css %][% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/noir/noir/fonts.css"><link rel="stylesheet" href="/lazysite-assets/noir/noir/main.css">[% END %]</head><body><header class="noir-top"><a class="name" href="#top">NOIR<b>.</b></a><nav><a href="#">Series</a><a href="#">Prints</a><a href="#">About</a><a href="/">Explorer</a></nav></header>[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]<footer class="noir-foot"><span>NOIR - a lazysite gallery theme. &copy; [% year %]</span><span><a href="/">Theme explorer</a> &middot; <a href="https://lazysite.io">This is a Lazysite</a></span></footer></body></html>
