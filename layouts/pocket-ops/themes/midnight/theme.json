      "ok": "#5ad17a",
      "ok-soft": "#1c3324",
      "warn": "#f0c06a",
      "warn-soft": "#4a3f00",
      "bad": "#ff6b6b",
      "bad-soft": "#402020",
      "bad-ink": "#1f0808",
      "info": "#93bfec",
      "info-soft": "#1c2b3c",
      "star": "#f2c14e",
