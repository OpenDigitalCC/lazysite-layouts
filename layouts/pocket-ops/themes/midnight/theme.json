{
  "name": "midnight",
  "version": "1.0.0",
  "description": "An always-dark working surface: charcoal panels, a soft blue accent, Inter. Colours from the catalogue theme dark (layouts/default), mapped to the pocket-ops short names. It stays dark whatever the device asks.",
  "author": "OpenDigitalCC",
  "layouts": [
    "pocket-ops"
  ],
  "requires": {
    "lazysite": "0.15.13"
  },
  "config": {
    "colours": {
      "canvas": "#1a1a1a",
      "surface": "#232323",
      "sunken": "#2a2a2a",
      "ink": "#f0f0f0",
