<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %][% theme_css %][% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/reel/reel/fonts.css"><link rel="stylesheet" href="/lazysite-assets/reel/reel/main.css">[% END %]</head><body><header class="reel-head"><a class="reel-logo" href="#top">Reel<b>.</b></a><nav class="reel-nav"><a href="#work">Work</a><span class="sep">&mdash;</span><a href="#about">Studio</a><span class="sep">&mdash;</span><a href="#work">Reel</a><span class="sep">&mdash;</span><a href="/">Explorer</a></nav></header>[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]<footer class="reel-foot">Reel - a lazysite cinematic theme. <a href="/">Back to the theme explorer</a> &middot; <a href="https://lazysite.io">This is a Lazysite</a> &middot; [% year %]</footer></body></html>
