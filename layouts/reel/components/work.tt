<section class="work" id="work"><div class="lead"><span class="eyebrow">[% data.eyebrow %]</span><h2>[% data.heading %]</h2></div><div class="films">[% FOREACH it IN data.items %]<a class="film"><div class="still" style="background:[% it.bg %]"></div><div class="meta"><span class="t">[% it.title %]</span><span class="c">[% it.caption %]</span></div></a>[% END %]</div></section>