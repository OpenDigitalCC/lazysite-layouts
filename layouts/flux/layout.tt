<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/flux/flux/main.css">[% END %]
</head>
<body>
<div class="progress"></div>
<nav class="flux-nav">
  <div class="inner">
    <a href="/" class="logo">FLUX</a>
    <a href="/">Theme Explorer &rarr;</a>
  </div>
</nav>

[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]

<footer class="flux-foot">
  <div class="inner">
    <span>&copy; [% year %] FLUX &mdash; scroll-driven cinema, native CSS, zero JavaScript.</span>
    <span><a href="/">Theme Explorer</a> &middot; <a href="https://lazysite.io">lazysite.io</a></span>
  </div>
</footer>
</body>
</html>
