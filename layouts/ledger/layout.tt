<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/main.css">[% END %]
</head>
<body>
<div class="led-wrap">

  <header class="led-banner">
    <h1 class="title"><a href="/">Fieldnotes: essays, notes &amp; work in progress</a></h1>
    <p class="desc">A working archive on craft, ideas and attention.</p>
    <div class="led-util">
      <input class="led-search" type="search" placeholder="Search articles&hellip;" aria-label="Search">
      <nav class="led-nav"><a href="/">Home</a><a href="#">Essays</a><a href="#">Notes</a><a href="#">About</a></nav>
    </div>
  </header>

  <div class="led-body">
    <aside class="led-side" aria-label="About">
      <div class="led-mod led-photo">
        <span class="ph"><svg viewBox="0 0 100 100" aria-hidden="true"><path d="M50 16a17 17 0 1 1 0 34 17 17 0 0 1 0-34zM16 96c0-19 15-32 34-32s34 13 34 32z"/></svg></span>
      </div>
      <div class="led-mod">
        <p>An independent writer and designer. I keep notes here on craft, the work of making things, and the ideas I want to come back to.</p>
        <p><a href="#">Email me</a></p>
      </div>
      <div class="led-mod">
        <h3>In print</h3>
        <div class="led-book"><span class="cov">FIELD NOTES</span><div><strong>Field Notes</strong><br><span class="d">A short book of essays. Out now.</span></div></div>
      </div>
    </aside>

    <main class="led-main" id="main">
      <div id="content">
        [% content %]
      </div>
    </main>

    <aside class="led-side2" aria-label="More">
      <div class="led-mod">
        <h3>Recent writing</h3>
        <ul>
          <li><a href="#">What the margins are for</a></li>
          <li><a href="#">On keeping a notebook</a></li>
          <li><a href="#">The shape of a good question</a></li>
          <li><a href="#">Reading twice</a></li>
          <li><a href="#">Small things, done daily</a></li>
        </ul>
      </div>
      <div class="led-mod">
        <h3>Topics</h3>
        <ul>
          <li><a href="#">Essays</a> <span class="d">(14)</span></li>
          <li><a href="#">Notes</a> <span class="d">(22)</span></li>
          <li><a href="#">Reading</a> <span class="d">(9)</span></li>
          <li><a href="#">Workshops &amp; talks</a> <span class="d">(5)</span></li>
        </ul>
      </div>
      <div class="led-mod">
        <h3>Elsewhere</h3>
        <ul>
          <li><a href="#">Newsletter</a></li>
          <li><a href="#">Talks &amp; recordings</a></li>
          <li><a href="#">Reading list</a></li>
        </ul>
      </div>
      <div class="led-mod">
        <h3>Archives</h3>
        <ul>
          <li><a href="#">June 2026</a></li>
          <li><a href="#">May 2026</a></li>
          <li><a href="#">April 2026</a></li>
          <li><a href="#">March 2026</a></li>
        </ul>
      </div>
    </aside>
  </div>

  <footer class="led-foot">
    <span>&copy; [% year %] Fieldnotes. Built with <a href="https://lazysite.io">lazysite</a>.</span>
    <span><a href="/">&larr; Theme explorer</a></span>
  </footer>

</div>
</body>
</html>
