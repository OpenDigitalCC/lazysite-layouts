<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/main.css">[% END %]
</head>
<body>
<nav class="ps-nav"><div class="in">
<a class="logo" href="#top">Carrick Advisory</a>
<ul class="links"><li><a href="#services">Services</a></li><li><a href="#approach">Approach</a></li><li><a href="/" class="ex">&larr; Explorer</a></li><li><a href="#contact" class="cta">Start a conversation</a></li></ul>
</div></nav>
[% content %]
<footer class="ps-foot"><div class="in">
<div><div class="logo">Carrick Advisory</div><p>Independent advisory for the public sector - strategy, assurance and digital, delivered with a duty of care.</p></div>
<div><h4>Practice</h4><ul><li><a href="#services">Services</a></li><li><a href="#approach">Approach</a></li><li><a href="#contact">Contact</a></li></ul></div>
<div><h4>lazysite</h4><ul><li><a href="/">Theme explorer</a></li><li><a href="https://lazysite.io">lazysite.io</a></li></ul></div>
</div><div class="base"><span>&copy; [% year %] Carrick Advisory - a lazysite professional-services theme.</span><span>Demo content</span></div></footer>
</body>
</html>
