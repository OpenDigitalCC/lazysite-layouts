<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/bio-bold/bio-bold/fonts.css"><link rel="stylesheet" href="/lazysite-assets/bio-bold/bio-bold/main.css">[% END %]
</head>
<body>
<nav class="bio-nav"><div class="in"><a class="me" href="#top">Jordan Vale</a><a class="ex" href="/">&larr; Explorer</a></div></nav>
[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]
<footer class="bio-foot">A personal-site theme for lazysite. <a href="/">Back to the theme explorer</a> &middot; <a href="https://lazysite.io">This is a Lazysite</a> &middot; [% year %]</footer>
</body>
</html>
