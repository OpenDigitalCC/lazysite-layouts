<!DOCTYPE html>
<html lang="[% page_lang || site_lang || 'en' %]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
[%# The <head> contract: page_meta_title / page_meta_desc arrive from the engine
    already resolved (meta_title // title, meta_desc // subtitle) and
    HTML-escaped - emit them WITHOUT | html, and never repeat the fallback here.
    og:site_name carries the site name, so og:title is the page title alone. %]
<title>[% page_meta_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_meta_desc %]<meta name="description" content="[% page_meta_desc %]">[% END %]
<meta property="og:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta property="og:description" content="[% page_meta_desc %]">[% END %]
<meta property="og:type" content="website">
[% IF site_name %]<meta property="og:site_name" content="[% site_name | html %]">[% END %]
[% IF site_url %]<meta property="og:url" content="[% site_url | html %][% request_uri | html %]">
<link rel="canonical" href="[% site_url | html %][% request_uri | html %]">[% END %]
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta name="twitter:description" content="[% page_meta_desc %]">[% END %]
<link rel="icon" href="[% theme_assets %]/favicon.svg" type="image/svg+xml">
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/quill/quill/fonts.css"><link rel="stylesheet" href="/lazysite-assets/quill/quill/main.css">[% END %]
</head>
<body>
<div class="q-shell">
<aside class="q-side">
<div class="av">[% site_name.substr(0, 1) %]</div>
<div class="pub"><a href="/">[% site_name %]</a></div>
<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="quill-links">&#9776;</button>
<nav class="q-nav" id="quill-links">
[%- plain = 0 %][% FOREACH item IN nav %][% UNLESS item.children.size %][% plain = plain + 1 %][% END %][% END -%]
[% IF plain %]
<div class="q-menu">
<h4>Menu</h4>
<ul>
[% FOREACH item IN nav %][% UNLESS item.children.size %]<li><a href="[% item.url %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a></li>
[% END %][% END %]
</ul>
</div>
[% END %]
[% FOREACH item IN nav %][% IF item.children.size %]
<div class="q-menu nav-group">
<h4>[% IF item.url %]<a href="[% item.url %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a>[% ELSE %]<span class="nav-group-label">[% item.label %]</span>[% END %]</h4>
<ul class="nav-children">
[% FOREACH child IN item.children %]<li><a href="[% child.url %]"[% IF request_uri == child.url %] class="active"[% END %]>[% child.label %]</a></li>
[% END %]
</ul>
</div>
[% END %][% END %]
<div class="q-auth">[% auth_control %]</div>
</nav>
</aside>
<main class="q-main">
<div class="q-inner">
[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% IF content %]<div class="q-page">
[% IF page_title %]<h1 class="page-title">[% page_title %]</h1>[% END %]
[% IF page_subtitle %]<p class="standfirst">[% page_subtitle %]</p>[% END %]
[% content %]
</div>[% END %]
</div>
<footer class="q-foot">&copy; [% year %] [% site_name %] &middot; <a href="https://lazysite.io">This is a Lazysite</a>[% IF page_modified %] &middot; <time datetime="[% page_modified_iso %]">Last updated: [% page_modified %]</time>[% END %]</footer>
</main>
</div>
<script>
(function(){var b=document.querySelector('.nav-toggle');if(!b)return;b.addEventListener('click',function(){var o=document.body.classList.toggle('nav-open');b.setAttribute('aria-expanded',o?'true':'false');});})();
</script>
</body>
</html>
