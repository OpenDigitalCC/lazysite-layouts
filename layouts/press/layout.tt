<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/press/press/fonts.css"><link rel="stylesheet" href="/lazysite-assets/press/press/main.css">[% END %]
</head>
<body>
<nav class="press-nav">
  <div class="edition">
    <div class="wrap"><span>Vol. I &middot; No. 1</span><span>The lazysite statement edition</span><span>Free</span></div>
  </div>
  <div class="bar">
    <a href="/" class="press-logo">The&nbsp;Press<b>.</b></a>
    <ul class="nav-links">
      <li><a href="#stories">Stories</a></li>
      <li><a href="#column">Column</a></li>
      <li><a href="#opinion">Opinion</a></li>
      <li><a href="/" class="nav-cta">Explorer</a></li>
    </ul>
  </div>
</nav>

[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]

<footer class="press-foot">
  <div class="inner">
    <div>
      <div class="logo">The Press<b style="color:var(--accent)">.</b></div>
      <p class="blurb">A newsprint brutalist statement theme for lazysite - hard rules, a heavy masthead, a breaking ticker and one news-red accent. Built to prove a static site can shout.</p>
    </div>
    <div>
      <h4>Sections</h4>
      <ul>
        <li><a href="#stories">Stories</a></li>
        <li><a href="#column">The column</a></li>
        <li><a href="#opinion">Opinion</a></li>
      </ul>
    </div>
    <div>
      <h4>lazysite</h4>
      <ul>
        <li><a href="/">Theme Explorer</a></li>
        <li><a href="https://lazysite.io" target="_blank" rel="noopener">This is a Lazysite</a></li>
      </ul>
    </div>
  </div>
  <div class="base">
    <span>&copy; [% year %] The Press - a lazysite statement theme</span>
    <span>Set in Anton &amp; Newsreader</span>
  </div>
</footer>

<script>
(function(){
  if (!('IntersectionObserver' in window)) { document.querySelectorAll('.reveal').forEach(function(e){e.classList.add('in');}); return; }
  var io = new IntersectionObserver(function(es){ es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } }); }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach(function(e){ io.observe(e); });
})();
</script>
</body>
</html>
