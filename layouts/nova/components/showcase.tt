<section class="section showcase reveal" id="showcase">
<div class="wrap">
<div class="split">
<div>
[% IF data.eyebrow %]<span class="eyebrow">[% data.eyebrow %]</span>[% END %]
<h2 class="h2">[% data.heading %]</h2>
[% IF data.lead %]<p class="lead">[% data.lead %]</p>[% END %]
[% IF data.action %]<div class="btn-row"><a href="[% data.action.href %]" class="btn btn-primary">[% data.action.label %]</a></div>[% END %]
</div>
<div class="mock"><div class="bar"><i></i><i></i><i></i></div><div class="orb"></div></div>
</div>
</div>
</section>
