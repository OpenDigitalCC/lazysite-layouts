<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %]
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/pulse/pulse/fonts.css"><link rel="stylesheet" href="/lazysite-assets/pulse/pulse/main.css">[% END %]
</head>
<body>
<nav class="pulse-nav">
  <div class="nav-inner">
    <a href="/" class="pulse-logo"><span class="dot"></span>PULSE</a>
    <ul class="nav-links">
      <li><a href="#concept">Concept</a></li>
      <li><a href="#start">Start</a></li>
      <li><a href="/" class="nav-cta">Theme Explorer</a></li>
    </ul>
  </div>
</nav>

[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]

<footer class="pulse-foot">
  <div class="inner">
    <div>
      <a href="/" class="pulse-logo"><span class="dot"></span>PULSE</a>
      <p class="blurb">A generative, interactive statement theme for lazysite. The hero is a live flow-field that responds to your cursor - no two visits the same, no framework in sight.</p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="#concept">The concept</a></li>
        <li><a href="#start">Get started</a></li>
      </ul>
    </div>
    <div>
      <h4>lazysite</h4>
      <ul>
        <li><a href="/">Theme Explorer</a></li>
        <li><a href="https://lazysite.io" target="_blank" rel="noopener">This is a Lazysite</a></li>
      </ul>
    </div>
  </div>
  <div class="base">
    <span>&copy; [% year %] PULSE - a generative lazysite statement theme.</span>
    <span>Canvas flow-field, ~60 lines of vanilla JS</span>
  </div>
</footer>

<script>
/* PULSE flow-field: particles advected through a procedural field, cursor-reactive. */
(function(){
  var c = document.getElementById('pulse-canvas'); if (!c) return;
  var ctx = c.getContext('2d'); var hero = c.parentElement;
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W=0, H=0, parts=[], N=0, t=0, raf=0;
  // Runtime palette comes from the active theme's CSS variables (accent /
  // accent-2 / accent-3), so any pulse theme variant recolours the canvas - not
  // just the hardcoded default. Falls back to the originals if a var is unset.
  var COLORS = (function(){
    var cs = getComputedStyle(document.documentElement);
    var fb = ['#5EEAD4','#A78BFA','#38BDF8'];
    var ks = ['--theme-colours-accent','--theme-colours-accent-2','--theme-colours-accent-3'];
    var out = [];
    for (var i = 0; i < ks.length; i++) {
      var v = (cs.getPropertyValue(ks[i]) || '').trim();
      out.push(v || fb[i]);
    }
    return out;
  })();
  var mouse = { x:-1e9, y:-1e9 };
  function mk(){ return { x:Math.random()*W, y:Math.random()*H, life:0, max:120+Math.random()*200, col:COLORS[(Math.random()*COLORS.length)|0] }; }
  function field(x,y,tt){ return (Math.sin(x*0.0016+tt)+Math.cos(y*0.0016-tt*0.8)+Math.sin((x+y)*0.0011+tt*0.4))*Math.PI; }
  function size(){
    W=hero.clientWidth; H=hero.clientHeight;
    c.width=W*DPR; c.height=H*DPR; c.style.width=W+'px'; c.style.height=H+'px';
    ctx.setTransform(DPR,0,0,DPR,0,0); ctx.fillStyle='#06060B'; ctx.fillRect(0,0,W,H);
    N=Math.round(Math.min(420,(W*H)/4600)); parts=[]; for(var i=0;i<N;i++) parts.push(mk());
  }
  function advance(tt){
    for(var i=0;i<parts.length;i++){
      var p=parts[i], a=field(p.x,p.y,tt), vx=Math.cos(a), vy=Math.sin(a);
      var dx=p.x-mouse.x, dy=p.y-mouse.y, d2=dx*dx+dy*dy;
      if(d2<28000){ var d=Math.sqrt(d2)||1; vx+=(-dy/d)*1.3+(dx/d)*0.25; vy+=(dx/d)*1.3+(dy/d)*0.25; }
      var px=p.x, py=p.y; p.x+=vx*1.5; p.y+=vy*1.5; p.life++;
      ctx.strokeStyle=p.col; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(px,py); ctx.lineTo(p.x,p.y); ctx.stroke();
      if(p.x<0||p.x>W||p.y<0||p.y>H||p.life>p.max) parts[i]=mk();
    }
  }
  function loop(){ t+=0.0016; ctx.globalAlpha=1; ctx.fillStyle='rgba(6,6,11,0.055)'; ctx.fillRect(0,0,W,H); ctx.globalAlpha=0.5; advance(t); raf=requestAnimationFrame(loop); }
  function start(){
    cancelAnimationFrame(raf); size();
    if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches){ ctx.globalAlpha=0.45; for(var k=0;k<60;k++) advance(k*0.05); ctx.globalAlpha=1; return; }
    raf=requestAnimationFrame(loop);
  }
  hero.addEventListener('pointermove', function(e){ var r=hero.getBoundingClientRect(); mouse.x=e.clientX-r.left; mouse.y=e.clientY-r.top; });
  hero.addEventListener('pointerleave', function(){ mouse.x=-1e9; mouse.y=-1e9; });
  var rt; window.addEventListener('resize', function(){ clearTimeout(rt); rt=setTimeout(start,160); });
  start();
})();
/* scroll-reveal */
(function(){
  if(!('IntersectionObserver' in window)){ document.querySelectorAll('.reveal').forEach(function(e){e.classList.add('in');}); return; }
  var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('in');io.unobserve(en.target);}});},{threshold:0.12});
  document.querySelectorAll('.reveal').forEach(function(e){io.observe(e);});
})();
</script>
</body>
</html>
