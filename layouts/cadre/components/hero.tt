<section class="hero" id="top"><span class="eyebrow">[% data.eyebrow %]</span><h1>[% data.heading %]</h1><p class="lead">[% data.lead %]</p><div class="btn-row">[% FOREACH a IN data.actions %]<a class="btn [% a.style == 'primary' ? 'btn-primary' : 'btn-ghost' %]" href="[% a.href %]">[% a.label %]</a>[% END %]</div></section>