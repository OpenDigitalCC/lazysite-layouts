<!DOCTYPE html>
<html lang="[% page_lang || site_lang || 'en' %]">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
[%# The <head> contract: page_meta_title / page_meta_desc arrive from the engine
    already resolved (meta_title // title, meta_desc // subtitle) and
    HTML-escaped - emit them WITHOUT | html, and never repeat the fallback here.
    og:site_name carries the site name, so og:title is the page title alone. %]
<title>[% page_meta_title %][% IF site_name %] - [% site_name %][% END %]</title>
[% IF page_meta_desc %]<meta name="description" content="[% page_meta_desc %]">[% END %]
<meta property="og:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta property="og:description" content="[% page_meta_desc %]">[% END %]
<meta property="og:type" content="website">
[% IF site_name %]<meta property="og:site_name" content="[% site_name | html %]">[% END %]
[% IF page_url %]<meta property="og:url" content="[% page_url %]">
<link rel="canonical" href="[% page_url %]">[% END %]
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="[% page_meta_title %]">
[% IF page_meta_desc %]<meta name="twitter:description" content="[% page_meta_desc %]">[% END %]
<link rel="alternate" type="application/rss+xml" title="[% IF site_name %][% site_name | html %] [% END %](RSS)" href="/feed.rss">
<link rel="alternate" type="application/atom+xml" title="[% IF site_name %][% site_name | html %] [% END %](Atom)" href="/feed.atom">
<link rel="icon" href="[% theme_assets %]/favicon.svg" type="image/svg+xml">
[% theme_css %]
[% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css?v=[% theme_version %]"><link rel="stylesheet" href="[% theme_assets %]/main.css?v=[% theme_version %]">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/cadre/cadre/fonts.css"><link rel="stylesheet" href="/lazysite-assets/cadre/cadre/main.css">[% END %]
</head>
<body>
<header class="cadre-top"><div class="in">
<a class="logo" href="/">[% site_name %]<b>.</b></a>
<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="cadre-links">&#9776;</button>
<ul class="links" id="cadre-links">
[% FOREACH item IN nav %]
[% IF item.children.size %]
<li class="nav-group">
[% IF item.url %]<a href="[% item.url | url_safe %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a>[% ELSE %]<span class="nav-group-label">[% item.label %]</span>[% END %]
<ul class="nav-children">
[% FOREACH child IN item.children %]<li><a href="[% child.url | url_safe %]"[% IF request_uri == child.url %] class="active"[% END %]>[% child.label %]</a></li>[% END %]
</ul>
</li>
[% ELSE %]
<li><a href="[% item.url | url_safe %]"[% IF request_uri == item.url %] class="active"[% END %]>[% item.label %]</a></li>
[% END %]
[% END %]
<li class="auth">[% IF odoo_signin_banner %][% odoo_signin_banner %][% ELSE %][% auth_control %][% END %]</li>
</ul>
</div></header>
[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% IF content %]<div class="cadre-page"><div class="wrap">
[% IF page_title %]<h1 class="page-title">[% page_title %]</h1>[% END %]
[% IF page_subtitle %]<p class="standfirst">[% page_subtitle %]</p>[% END %]
[% content %]
</div></div>[% END %]
<footer class="cadre-foot"><span>&copy; [% year %] [% site_name %][% IF page_modified %] &middot; <time datetime="[% page_modified_iso %]">Last updated: [% page_modified %]</time>[% END %]</span><span><span class="feed-links"><a href="/feed.rss">RSS</a> &middot; <a href="/feed.atom">Atom</a></span> &middot; <a href="https://lazysite.io">This is a Lazysite</a></span></footer>
<script>
(function(){var b=document.querySelector('.nav-toggle');if(!b)return;b.addEventListener('click',function(){var o=document.body.classList.toggle('nav-open');b.setAttribute('aria-expanded',o?'true':'false');});})();
</script>
</body>
</html>
