<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>[% IF page_subtitle %]<meta name="description" content="[% page_subtitle | html %]">[% END %][% theme_css %][% IF theme_assets %]<link rel="stylesheet" href="[% theme_assets %]/fonts.css"><link rel="stylesheet" href="[% theme_assets %]/main.css">[% ELSE %]<link rel="stylesheet" href="/lazysite-assets/cadre/cadre/fonts.css"><link rel="stylesheet" href="/lazysite-assets/cadre/cadre/main.css">[% END %]</head><body><header class="cadre-top"><div class="in"><a class="logo" href="#top">Cadre<b>&reg;</b></a><nav><a href="#work">Work</a><a href="#contact">Contact</a><a href="/">Explorer</a></nav></div></header>[% FOREACH s IN sections %][% type = s.keys.first %]
[% INCLUDE "components/${type}.tt" data = s.$type %][% END %]
[% content %]<footer class="cadre-foot"><span>Cadre - a lazysite studio theme. &copy; [% year %]</span><span><a href="/">Theme explorer</a> &middot; <a href="https://lazysite.io">This is a Lazysite</a></span></footer></body></html>
